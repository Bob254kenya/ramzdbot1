        "@babel/preset-typescript": "^7.24.1",
        "@rsbuild/core": "^1.0.1-beta.1",
        "@rsbuild/plugin-react": "^1.0.1-beta.1",
        "@rsbuild/plugin-sass": "^1.0.1-beta.1",
        "@types/react": "^18.3.3",
        "@types/react-dom": "^18.3.0",
        "typescript": "^5.5.3",
        "webpack": "^5.92.1",
        "webpack-cli": "^5.1.4",
