{
    "name": "bot",
    "private": true,
    "version": "0.0.1",
    "engines": {
        "node": "24.x"
    },
    "scripts": {
        "start": "rsbuild dev",
        "build": "rsbuild build",
        "watch": "rsbuild build --watch",
        "serve": "live-server --port=8443 --host=0.0.0.0 dist",
        "start:webpack": "webpack serve --open --config webpack.config.js",
        "build:webpack": "webpack --config webpack.config.js",
        "test:lint": "prettier --log-level silent --write . && eslint \"./src/**/*.?(js|jsx|ts|tsx)\"",
        "test:fix": "prettier --log-level silent --write . && eslint --fix \"./src/**/*.?(js|jsx|ts|tsx)\"",
        "test": "jest",
        "coverage": "jest --coverage",
        "prepare": "husky install",
        "build:analyze": "BUNDLE_ANALYZE=true rsbuild build"
    },
    "dependencies": {
        "@datadog/browser-rum": "^5.31.1",
        "@deriv-com/analytics": "^1.5.3",
        "@deriv-com/auth-client": "^1.4.6",
        "@deriv-com/quill-ui": "1.18.1",
        "@deriv-com/translations": "^1.3.9",
        "@deriv-com/ui": "^1.37.1",
        "@deriv-com/utils": "latest",
        "@deriv/deriv-api": "^1.0.15",
        "@deriv/deriv-charts": "^2.5.1",
        "@deriv/js-interpreter": "^3.0.0",
        "@deriv/quill-icons": "^2.2.0",
        "@svgr/core": "^8.1.0",
        "@tanstack/react-query": "^5.29.2",
        "blockly": "^10.4.3",
        "canvas-toBlob": "^1.0.0",
        "classnames": "^2.5.1",
        "clsx": "^2.1.0",
        "crc-32": "^1.2.2",
        "debounce": "^2.1.0",
        "dompurify": "^3.1.3",
        "dotenv": "^16.4.5",
        "file-saver": "^2.0.5",
        "formik": "^2.4.6",
        "framer-motion": "^6.5.1",
        "html-react-parser": "^5.1.18",
        "js-cookie": "^3.0.5",
        "localforage": "^1.10.0",
        "lucide-react": "^0.503.0",
        "lz-string": "^1.5.0",
        "mobx": "^6.12.3",
        "mobx-react-lite": "^4.0.7",
        "moment": "^2.30.1",
        "pako": "^2.1.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-router-dom": "^6.25.1",
        "redux": "^5.0.1",
